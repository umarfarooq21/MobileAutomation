#!/bin/sh
# Refresh the README "Test status" tables from local run results and include
# the updated README in this commit (so every push carries the latest table).
ROOT="$(git rev-parse --show-toplevel)"
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="python3"
"$PY" "$ROOT/scripts/update_readme_status.py" || exit 0
git add "$ROOT/README.md"
exit 0
