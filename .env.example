# Grocery latency Appium harness — local secrets (do not commit)
# Device — set ACTIVE_DEVICE to iphone16 or iphone14
ACTIVE_DEVICE=iphone16

# iPhone 16
IPHONE16_UDID=<your-iphone16-udid>
IPHONE16_IOS_VERSION=26.5
IPHONE16_DEVICE_NAME=iPhone16

# iPhone 14 (second test device)
IPHONE14_UDID=<your-iphone14-udid>
IPHONE14_IOS_VERSION=26.6.2
IPHONE14_DEVICE_NAME=iPhone

# Appium server
APPIUM_URL=http://127.0.0.1:4723

# Session
NEW_COMMAND_TIMEOUT=300
WDA_LAUNCH_TIMEOUT=120000
WDA_STARTUP_RETRIES=4
NO_RESET=true

# Optional WDA signing (required on this Mac for real-device WDA)
# XCODE_ORG_ID=<your-apple-team-id>
# XCODE_SIGNING_ID=Apple Development
# UPDATED_WDA_BUNDLE_ID=com.facebook.WebDriverAgentRunner.<your-suffix>

# Retailer bundle IDs (iOS App Store builds; Amazon on this phone is com.amazon.Amazon)
AMAZON_BUNDLE_ID=com.amazon.Amazon
WALMART_BUNDLE_ID=com.walmart.electronics
INSTACART_BUNDLE_ID=com.instacart.Instacart

# Output
ARTIFACTS_DIR=artifacts
LOGIN_PAUSE_SECONDS=90

# task1_cart_checkout_cancel
ASSIGNED_QUANTITY=2
RECORDING_TIME_LIMIT_SECONDS=600
# Prefer a higher command timeout for the long recorded checkout+cancel run:
# NEW_COMMAND_TIMEOUT=900

# Master ASIN list (comma/space separated). Opens PDPs directly — no grocery search.
AMAZON_ASINS=B001W3T2E4,B000NOGKN4,B003AYKYIG,B00HT7U55W,B000P6G12U,B000NSFQIU
# Or point at a file (one ASIN per line):
# AMAZON_ASIN_LIST_FILE=data/amazon_master_asins.txt
# Skip add-to-cart when cart already has items (fast checkout-only reruns):
# SKIP_ADD_IF_CART_NONEMPTY=true
